datasource db {
  provider = "sqlite" 
  url = "file:./database.db"
}

generator client {
  provider = "prisma-client-js"
}

model PureItem {
  id            String   @id 
  client        String
  offerId       String
  rawProperties String
  remoteImages  String   
  createdAt     DateTime @default(now())
}

model Image {
  url                   String  @id
  index                 Int  
  error                 String?
  medianEdgeBrightness  Float?
  averageAllBrightness  Float? 
  uniqueAllColorsCount  Float?
  uniqueEdgeColorsCount Float?
  width                 Float? 
  height                Float?
}