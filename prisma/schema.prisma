datasource db {
  provider = "sqlite" 
  url = "file:./database.db"
}

generator client {
  provider = "prisma-client-js"
}

model PureItem {
  id            String   @id 
  images        Image[]
  remoteImages  String
  client        String
  offerId       String
  rawProperties String
  shops         String
  createdAt     DateTime @default(now())

  @@index([client])
}

model Image {
  url                   String  @id
  pureItem              PureItem @relation(fields: [pureItemId], references: [id])
  pureItemId            String
  index                 Int  
  error                 String?
  medianEdgeBrightness  Float?
  uniqueEdgeColorsCount Float?
  averageEdgeColor      String?
  uniqueAllColorsCount  Float?
  averageProductBrightness  Float? 
  averageProductColor   String?
  productBgPixelShare   Float?
  width                 Float?
  height                Float?
  compressedSize        Int?
  boundingBoxTop        Int?
  boundingBoxBottom     Int?
  boundingBoxLeft       Int?
  boundingBoxRight      Int?
}
